# Backend environment variables (FastAPI)

# Optional: additional allowed browser origins for CORS.
# Default already includes:
# - http://localhost:3000
# - http://127.0.0.1:3000
FRONTEND_ORIGIN=http://localhost:3000

# Optional: override path to JSON file used for persistence.
# Default: data/notes.json (relative to backend working directory)
NOTES_DATA_PATH=./data/notes.json

# Optional: logging level (INFO, DEBUG, etc.)
LOG_LEVEL=INFO
